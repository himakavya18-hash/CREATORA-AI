# Flask settings
FLASK_ENV=development
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production
ADMIN_REGISTRATION_KEY=

# Supabase PostgreSQL connection string (Project Settings > Database > Connection string)
SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b

# Conversion used only for default/sample rates when converting old USD examples to INR.
USD_TO_INR=96.20

# Feature flags & Cost Controls
AI_FALLBACK_MODE=true
LOW_COST_MODE=true
AI_DAILY_LIMIT_PER_USER=0
